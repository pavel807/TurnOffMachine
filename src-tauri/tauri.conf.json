{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurnOFFMachine",
  "version": "1.3.0",
  "identifier": "com.pavellabushev.turnoffmachine",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Turn Off Machine",
        "width": 375,
        "height": 625,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5QjU2NTc4RTFFRjRDM0UKUldRK1RPL2hlR1cxeVE1TVlkQ2hjdEF4TkJNWnJzWVZyWkFJWnpQVHFmRUxNemtKWTVSY2JiTkIK",
      "endpoints": [
        "https://github.com/pavel807/TurnOffMachine/releases/latest/download/latest.json"
      ]
    }
  }
}
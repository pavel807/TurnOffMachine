//! Голос ZONOS3 как движок синтеза для `tts`.
//!
//! Обёртка превращает `ZonosEngine` в `SpeechEngine`: берёт эмбеддинг
//! голоса (из спикер-энкодера или из ассетов), переводит скорость речи в
//! бакет условия `speaking_rate` и отдаёт готовые сэмплы 44.1 кГц.

use super::codec::ZacDecoder;
use super::engine::{
    AudioDecoder, BlockEdge, SAMPLE_RATE, StreamBlock, StreamingCfg, ZonosEngine, default_buckets,
    polish_block,
};
use super::sampler::Sampling;
use anyhow::{Context, Result, bail};
use std::collections::HashMap;
use std::path::{Path, PathBuf};
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::mpsc::channel;
use std::sync::{Arc, Mutex};
use std::time::Instant;

/// Голос ZONOS3: модель + эмбеддинг голоса + ZAC-декодер.
pub struct ZonosVoice {
    /// Слот движка: None — движок вынут для потокового синтеза.
    engine: Mutex<Option<ZonosEngine>>,
    /// Декодер кодов в звук (общий на все голоса).
    decoder: Option<Arc<ZacDecoder>>,
    /// 192-мерный эмбеддинг голоса (клонирование по опорной записи).
    speaker: Option<Vec<f32>>,
    /// Бакеты условий: громкость, f_max, темп.
    buckets: [usize; 3],
    /// Параметры сэмплирования.
    sampling: Sampling,
    /// Усиление клонирования (CFG). В бою 1.0: CFG 1.5 давал +0.038
    /// косинуса похожести на коротких фразах, но на реальных ответах
    /// обрушил разборчивость текста до 0.22 (жалоба пользователя) —
    /// откат. Ручка для экспериментов: JARVIS_TTS_CFG=1.5.
    cfg_scale: f32,
    /// Имя голоса (для интерфейса и кэша).
    voice_name: String,
    /// Каталог `voices/` с эмбеддингами для превью других голосов.
    voices_dir: Option<PathBuf>,
    /// Кэш эмбеддингов превью: имя → эмбеддинг (None — голоса нет).
    preview: Mutex<HashMap<String, Option<Vec<f32>>>>,
}

impl ZonosVoice {
    /// Собрать голос из уже загруженного движка.
    ///
    /// `decoder` — ZAC-декодер (общий между голосами); без него синтез вернёт
    /// только коды кадров, звук не соберётся.
    pub fn new(
        engine: ZonosEngine,
        decoder: Option<Arc<ZacDecoder>>,
        speaker: Option<Vec<f32>>,
        buckets: Option<[usize; 3]>,
        voice_name: impl Into<String>,
    ) -> Self {
        Self::with_preview_dir(engine, decoder, speaker, buckets, voice_name, None)
    }

    /// Как [`new`], но с каталогом `voices/` для превью других голосов.
    pub fn with_preview_dir(
        engine: ZonosEngine,
        decoder: Option<Arc<ZacDecoder>>,
        speaker: Option<Vec<f32>>,
        buckets: Option<[usize; 3]>,
        voice_name: impl Into<String>,
        voices_dir: Option<PathBuf>,
    ) -> Self {
        let buckets = buckets.unwrap_or_else(|| default_buckets(&engine.cfg));
        // Боевые дефолты: 0.6 — первая попытка почти всегда без искажений
        // (0.75 чаще заикается и уходит в пересинтез), сид 1 проходит
        // самопроверку с первой попытки чаще, чем 0. CFG не используем:
        // он вдвое дороже и портит текст, а голос задаёт эмбеддинг.
        // Ручки для замеров: JARVIS_TTS_TEMP, JARVIS_TTS_SEED.
        let mut sampling = Sampling::default();
        sampling.temperature = std::env::var("JARVIS_TTS_TEMP")
            .ok()
            .and_then(|v| v.parse::<f32>().ok())
            .filter(|t| (0.0..=2.0).contains(t))
            .unwrap_or(0.6);
        sampling.seed = 1;
        if let Ok(v) = std::env::var("JARVIS_TTS_SEED") {
            if let Ok(seed) = v.parse() {
                sampling.seed = seed;
            }
        }
        // Ручки против «каши из слов» (подбор — через tts_sweep/probe_voice_fit).
        // Главный рычаг — min_p: режет мусорный хвост распределения, из которого
        // растут вставленные слова, и не стоит ничего (в отличие от CFG).
        // Дефолты — реестр генерации ZONOS3.
        sampling.top_p = env_f32("JARVIS_TTS_TOP_P", sampling.top_p, 0.0..=1.0);
        sampling.min_p = env_f32("JARVIS_TTS_MIN_P", sampling.min_p, 0.0..=1.0);
        sampling.rep_penalty = env_f32("JARVIS_TTS_REP_PENALTY", sampling.rep_penalty, 1.0..=3.0);
        if let Ok(v) = std::env::var("JARVIS_TTS_TOP_K")
            && let Ok(k) = v.parse::<usize>()
        {
            sampling.top_k = k.max(1);
        }
        Self {
            engine: Mutex::new(Some(engine)),
            decoder,
            speaker,
            buckets,
            sampling,
            cfg_scale: std::env::var("JARVIS_TTS_CFG")
                .ok()
                .and_then(|v| v.parse::<f32>().ok())
                .filter(|c| (1.0..=3.0).contains(c))
                .unwrap_or(1.0),
            voice_name: voice_name.into(),
            voices_dir,
            preview: Mutex::new(HashMap::new()),
        }
    }

    /// Заменить эмбеддинг голоса (новый клон).
    pub fn set_speaker(&mut self, speaker: Option<Vec<f32>>) {
        self.speaker = speaker;
    }

    /// Эмбеддинг голоса.
    pub fn speaker(&self) -> Option<&[f32]> {
        self.speaker.as_deref()
    }

    /// Имя голоса.
    pub fn voice_name(&self) -> &str {
        &self.voice_name
    }

    /// Параметры сэмплирования (сид/температура) — для вариаций синтеза.
    pub fn set_sampling(&mut self, sp: Sampling) {
        self.sampling = sp;
    }

    /// Усиление клонирования голоса (CFG scale). Только для офлайн-замеров:
    /// боевой путь всегда работает с 1.0 (см. комментарий к полю).
    pub fn set_cfg_scale(&mut self, scale: f32) {
        self.cfg_scale = scale;
    }

    /// Эмбеддинг голоса по имени: свой — для текущего голоса, чужие —
    /// из каталога `voices/` (кэшируется).
    fn speaker_for(&self, name: &str) -> Option<Vec<f32>> {
        if name == self.voice_name {
            return self.speaker.clone();
        }
        let dir = self.voices_dir.as_ref()?;
        let mut cache = self.preview.lock().ok()?;
        if let Some(cached) = cache.get(name) {
            return cached.clone();
        }
        let emb = load_voice_embedding(dir, name);
        cache.insert(name.to_string(), emb.clone());
        emb
    }

    /// Бакет темпа речи по скорости: 1.0 — естественный темп, меньше — медленнее.
    ///
    /// Скорость в интерфейсе — множитель, а модель управляется абсолютным
    /// темпом в «байтах UTF-8 в секунду». Переводим через середину
    /// диапазона бакетов: 1.0 → средний бакет, 0.5 → нижний, 1.5 → верхний.
    pub fn speed_bucket(&self, speed: f32) -> usize {
        let n = self
            .engine
            .lock()
            .map(|g| {
                g.as_ref()
                    .map(|e| e.cfg.unknown_bucket(2))
                    .unwrap_or(30)
            })
            .unwrap_or(30);
        speed_bucket_for(n, speed)
    }
}

/// Чистый перевод скорости в бакет темпа (`n` — число бакетов условия).
fn speed_bucket_for(n: usize, speed: f32) -> usize {
    if n == 0 {
        return 0;
    }
    // Естественный темп — «неизвестно»: модель стабильнее на unknown,
    // чем на конкретных бакетах (проверено: средний бакет даёт заикания).
    if (speed - 1.0).abs() < 0.04 {
        return n;
    }
    let mid = (n.saturating_sub(1)) as f32 / 2.0;
    let scaled = mid * speed.clamp(0.5, 1.5) / 1.0;
    (scaled.round().max(0.0) as usize).min(n - 1)
}

/// Бакеты с env-переопределением громкости/f_max (нужны счётчики из cfg).
fn buckets_with_env(mut b: [usize; 3], counts: &[usize]) -> [usize; 3] {
    for (slot, name) in [(0usize, "JARVIS_TTS_LOUDNESS_BUCKET"), (1, "JARVIS_TTS_FMAX_BUCKET")] {
        if let Ok(v) = std::env::var(name)
            && let Ok(x) = v.parse::<usize>()
        {
            b[slot] = x.min(counts[slot].saturating_sub(1));
        }
    }
    b
}

/// f32 из env с диапазоном и дефолтом — для ручек сэмплинга.
fn env_f32(name: &str, default: f32, range: std::ops::RangeInclusive<f32>) -> f32 {
    std::env::var(name)
        .ok()
        .and_then(|v| v.parse::<f32>().ok())
        .filter(|v| range.contains(v))
        .unwrap_or(default)
}

/// Требование движка синтеза речи: единый интерфейс для `tts`.
pub trait SpeechEngine: Send + Sync {
    /// Частота дискретизации выходного звука.
    fn sample_rate(&self) -> u32;
    /// Синтез речи с текущим голосом.
    fn speak(&self, text: &str, speed: f32) -> Result<Vec<f32>>;
    /// Синтез речи заданным голосом (превью в интерфейсе).
    fn speak_with(&self, voice: &str, text: &str, speed: f32) -> Result<Vec<f32>>;
    /// Имя движка: «zonos».
    fn engine_name(&self) -> &'static str;
    /// Потоковый синтез: блоки аудио отдаются по мере генерации —
    /// воспроизведение начинается до конца синтеза. `emit(audio, last)`
    /// вызывается для каждого блока, `cancel` — внешний флаг остановки
    /// (перебивание). Дефолт — классический путь одним блоком.
    fn speak_streaming(
        &self,
        text: &str,
        speed: f32,
        cancel: &AtomicBool,
        emit: &mut dyn FnMut(Vec<f32>, bool),
    ) -> Result<()> {
        let _cancel = cancel;
        let audio = self.speak(text, speed)?;
        if !audio.is_empty() {
            emit(audio, true);
        }
        Ok(())
    }
}

/// Загрузить эмбеддинг голоса (192 измерения) из `.npy`.
///
/// Ищем `voices/<голос>.embedding.npy`, затем `<голос>.embedding.npy` в
/// каталоге весов. Формат — обычный numpy: заголовок-словарь и сырые f32.
pub fn load_voice_embedding(dir: &Path, voice: &str) -> Option<Vec<f32>> {
    let candidates = [
        dir.join("voices").join(format!("{voice}.embedding.npy")),
        dir.join(format!("{voice}.embedding.npy")),
    ];
    for path in candidates {
        if let Ok(bytes) = std::fs::read(&path) {
            if let Some(values) = parse_npy_f32(&bytes) {
                if values.len() == 192 {
                    return Some(values);
                }
            }
        }
    }
    None
}

/// Минимальный читатель `.npy` с одномерным массивом f32.
fn parse_npy_f32(bytes: &[u8]) -> Option<Vec<f32>> {
    if bytes.len() < 10 || &bytes[0..6] != b"\x93NUMPY" {
        return None;
    }
    let major = bytes[6];
    let (header_len, header_start) = if major == 1 {
        (u16::from_le_bytes([bytes[8], bytes[9]]) as usize, 10)
    } else {
        (
            u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]) as usize,
            12,
        )
    };
    let header = std::str::from_utf8(bytes.get(header_start..header_start + header_len)?).ok()?;
    if !header.contains("'<f4'") && !header.contains("\"<f4\"") {
        return None;
    }
    let data = bytes.get(header_start + header_len..)?;
    let count = data.len() / 4;
    let mut out = Vec::with_capacity(count);
    for chunk in data.chunks_exact(4) {
        out.push(f32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]));
    }
    Some(out)
}

impl ZonosVoice {
    /// Синтез с самопроверкой: сэмплинг ZONOS3 иногда вставляет или повторяет
    /// слова, поэтому прогон через FastConformer сравнивается с текстом;
    /// при совпадении ниже 0.88 — пересинтез со следующим сидом (по умолчанию
    /// до 2 попыток: первая при temp 0.6 обычно уже годная, а лишние попытки
    /// стоят секунды). В ответ уходит лучший вариант. Без ASR-модели — как
    /// есть, одна попытка.
    fn speak_internal(
        &self,
        speaker: Option<Vec<f32>>,
        text: &str,
        speed: f32,
    ) -> Result<Vec<f32>> {
        let Some(decoder) = self.decoder.as_ref() else {
            anyhow::bail!("ZONOS3: нет ZAC-декодера (коды есть, звук не собирается)");
        };
        let mut buckets = self.buckets;
        buckets[2] = self.speed_bucket(speed);
        let mut engine_slot = self
            .engine
            .lock()
            .map_err(|_| anyhow::anyhow!("ZONOS3: движок заблокирован"))?;
        let Some(engine) = engine_slot.as_mut() else {
            anyhow::bail!("ZONOS3: движок занят потоковым синтезом");
        };
        // Громкость и f_max — условия записи эталона; по умолчанию
        // «неизвестно». Фиксируются через env (см. buckets_with_env).
        let buckets = buckets_with_env(buckets, &engine.cfg.condition_bucket_counts);
        let asr = voice_asr();
        let max_attempts = std::env::var("JARVIS_TTS_ATTEMPTS")
            .ok()
            .and_then(|v| v.parse::<u32>().ok())
            .unwrap_or(2)
            .clamp(1, 4);

        let mut best: Option<(f32, Vec<f32>)> = None;
        for attempt in 0..max_attempts {
            let mut sp = self.sampling.clone();
            sp.seed = self.sampling.seed.wrapping_add(attempt);
            let started = std::time::Instant::now();
            let out = engine
                .synthesize(text, speaker.as_deref(), buckets, &sp, self.cfg_scale, Some(decoder.as_ref()))
                .context("ZONOS3: синтез не удался")?;
            let synth_secs = started.elapsed().as_secs_f32();
            match asr {
                Some(model) => {
                    // FastConformer обучен на 16 кГц; синтез — 44.1 кГц.
                    let asr_started = std::time::Instant::now();
                    let pcm16 = crate::tts_zonos::speaker::sinc_resample(
                        &out.audio,
                        SAMPLE_RATE,
                        16000,
                    );
                    let said = model.transcribe(&pcm16)?;
                    let asr_secs = asr_started.elapsed().as_secs_f32();
                    let sim = speech_similarity(text, said.text.trim());
                    if std::env::var_os("JARVIS_VOICE_DEBUG").is_some() {
                        eprintln!(
                            "🎤 attempt {attempt} seed {} synth {synth_secs:.1}s asr {asr_secs:.1}s sim {sim:.3} len {:.1}s: {}",
                            sp.seed,
                            out.audio.len() as f32 / SAMPLE_RATE as f32,
                            said.text.trim()
                        );
                    }
                    if best.as_ref().is_none_or(|(b, _)| sim > *b) {
                        best = Some((sim, out.audio));
                    }
                    if sim >= 0.88 {
                        break;
                    }
                }
                None => return Ok(out.audio),
            }
        }
        Ok(best.map(|(_, a)| a).expect("хотя бы одна попытка"))
    }
}

impl SpeechEngine for ZonosVoice {
    fn sample_rate(&self) -> u32 {
        SAMPLE_RATE
    }

    fn speak(&self, text: &str, speed: f32) -> Result<Vec<f32>> {
        self.speak_internal(self.speaker.clone(), text, speed)
    }

    fn speak_with(&self, voice: &str, text: &str, speed: f32) -> Result<Vec<f32>> {
        let speaker = self.speaker_for(voice).or_else(|| self.speaker.clone());
        self.speak_internal(speaker, text, speed)
    }

    fn engine_name(&self) -> &'static str {
        "zonos"
    }

    fn speak_streaming(
        &self,
        text: &str,
        speed: f32,
        cancel: &AtomicBool,
        emit: &mut dyn FnMut(Vec<f32>, bool),
    ) -> Result<()> {
        let Some(decoder) = self.decoder.as_ref() else {
            bail!("ZONOS3: нет ZAC-декодера (коды есть, звук не собирается)");
        };
        let speaker = self.speaker.clone();

        // Бакеты считаем до выемки движка: speed_bucket и env-правки
        // читают конфиг из слота.
        let buckets = {
            let guard = self
                .engine
                .lock()
                .map_err(|_| anyhow::anyhow!("ZONOS3: движок заблокирован"))?;
            let Some(engine) = guard.as_ref() else {
                bail!("ZONOS3: движок занят");
            };
            let mut b = self.buckets;
            b[2] = speed_bucket_for(engine.cfg.unknown_bucket(2), speed);
            buckets_with_env(b, &engine.cfg.condition_bucket_counts)
        };

        // Вынимаем движок из слота: потоковый синтез работает с ним
        // напрямую, между попытками. Возврат — на любом выходе.
        let mut put_back = {
            let mut guard = self
                .engine
                .lock()
                .map_err(|_| anyhow::anyhow!("ZONOS3: движок заблокирован"))?;
            struct PutBack<'a>(&'a Mutex<Option<ZonosEngine>>, Option<ZonosEngine>);
            impl Drop for PutBack<'_> {
                fn drop(&mut self) {
                    if let Some(engine) = self.1.take() {
                        *self.0.lock().unwrap_or_else(|e| e.into_inner()) = Some(engine);
                    }
                }
            }
            let engine = guard
                .take()
                .ok_or_else(|| anyhow::anyhow!("ZONOS3: движок занят"))?;
            PutBack(&self.engine, Some(engine))
        };

        let asr = voice_asr();
        let max_attempts = std::env::var("JARVIS_TTS_ATTEMPTS")
            .ok()
            .and_then(|v| v.parse::<u32>().ok())
            .unwrap_or(2)
            .clamp(1, 4);
        let mut gain = 1.0f32;
        let mut played_any = false;

        for attempt in 0..max_attempts {
            if cancel.load(Ordering::SeqCst) {
                break;
            }
            let mut sp = self.sampling.clone();
            sp.seed = self.sampling.seed.wrapping_add(attempt);
            let started = Instant::now();
            let engine = put_back
                .1
                .as_mut()
                .expect("движок должен быть в слоте после попытки");
            let out = stream_attempt(
                engine,
                decoder,
                text,
                speaker.as_deref(),
                buckets,
                &sp,
                self.cfg_scale,
                cancel,
                &mut gain,
                emit,
                asr,
            );
            if std::env::var_os("JARVIS_VOICE_DEBUG").is_some() {
                eprintln!(
                    "🎤 stream attempt {attempt} seed {} ttfa {:?} начало {:?} sim {:?} played {} занял {:.1}s",
                    sp.seed,
                    out.first_emit_secs,
                    out.first_sim,
                    out.final_sim,
                    out.first_played,
                    started.elapsed().as_secs_f32()
                );
            }
            played_any |= out.first_played;
            if let Some(err) = out.error {
                bail!("ZONOS3: {err}");
            }
            if out.cancelled {
                break;
            }
            if out.first_played {
                if out.final_sim.is_none_or(|sim| sim >= 0.88) {
                    break;
                }
                // Хвост оказался неразборчивым, но он уже прозвучал: пересинтез
                // не вернёт скрытое. Повтор фразы целиком — только по флагу.
                if !std::env::var_os("JARVIS_TTS_REPLAY").is_some_and(|v| v == "1") {
                    eprintln!(
                        "⚠️ Речь прозвучала с похожестию {:.2} — повтор выключен (JARVIS_TTS_REPLAY=1)",
                        out.final_sim.unwrap_or(0.0)
                    );
                    break;
                }
                continue;
            }
            // Начало фразы неразборчиво — пересинтез ещё до первого звука.
        }

        if !played_any && !cancel.load(Ordering::SeqCst) {
            // Ни одна попытка не прошла проверку начала: классический путь
            // с лучшей из попыток — медленнее, но речь прозвучит.
            drop(put_back);
            let audio = self.speak_internal(speaker, text, speed)?;
            if !audio.is_empty() {
                let mut block = audio;
                polish_block(&mut block, SAMPLE_RATE, &mut gain, BlockEdge::First);
                emit(block, true);
            }
        }

        Ok(())
    }
}

/// Итог одной потоковой попытки.
struct AttemptOutcome {
    /// Была ли воспроизведена хотя бы часть.
    first_played: bool,
    /// Точность начала фразы (проверка до первого звука).
    first_sim: Option<f32>,
    /// Сходство всей фразы (проверка после генерации).
    final_sim: Option<f32>,
    /// Внешняя остановка (Stop/перебивание).
    cancelled: bool,
    /// Ошибка декодера.
    error: Option<String>,
    /// Через сколько секунд после старта прозвучал первый блок.
    first_emit_secs: Option<f32>,
}

/// Приёмник декодированных блоков: проверка начала, полировка, выдача.
struct Sink<'a> {
    text: &'a str,
    asr: Option<&'static crate::asr::model::FastConformer>,
    gain: &'a mut f32,
    emit: &'a mut dyn FnMut(Vec<f32>, bool),
    accepted: Vec<f32>,
    first_done: bool,
    first_sim: Option<f32>,
    garbage: bool,
    error: Option<String>,
    first_emit_secs: Option<f32>,
}

impl Sink<'_> {
    fn take(&mut self, res: Result<(Vec<f32>, usize, usize, bool), String>, started: Instant) {
        let (raw, _, _, last) = match res {
            Ok(v) => v,
            Err(e) => {
                self.error = Some(e);
                return;
            }
        };
        if !self.first_done {
            // Точка проверки: первый блок прогоняется через ASR ещё до
            // начала воспроизведения — при мусоре попытка отменяется.
            if let Some(model) = self.asr {
                if raw.is_empty() {
                    return;
                }
                let pcm16 =
                    crate::tts_zonos::speaker::sinc_resample(&raw, SAMPLE_RATE, 16000);
                if let Ok(said) = model.transcribe(&pcm16) {
                    let precision = prefix_precision(self.text, said.text.trim());
                    self.first_sim = Some(precision);
                    if precision < PREFIX_PRECISION {
                        self.garbage = true;
                        return;
                    }
                }
            }
            if raw.is_empty() {
                return;
            }
        }
        let mut block = raw;
        let edge = if !self.first_done {
            BlockEdge::First
        } else if last {
            BlockEdge::Last
        } else {
            BlockEdge::Mid
        };
        polish_block(&mut block, SAMPLE_RATE, self.gain, edge);
        if !self.first_done {
            self.first_emit_secs = Some(started.elapsed().as_secs_f32());
        }
        self.first_done = true;
        self.accepted.extend_from_slice(&block);
        (self.emit)(block, last);
    }
}

/// Порог точности начала фразы: ниже — начало считается мусором.
const PREFIX_PRECISION: f32 = 0.6;

/// Слова, нормированные к нижнему регистру без пунктуации (ё → е).
fn words_norm(s: &str) -> Vec<String> {
    s.to_lowercase()
        .replace('ё', "е")
        .split(|c: char| c.is_whitespace() || c.is_ascii_punctuation() || "—–«»…".contains(c))
        .filter(|w| !w.is_empty())
        .map(String::from)
        .collect()
}

/// Точность начала: доля сказанных слов, найденных в ожидаемом тексте.
/// Вставленный мусор и повторы её роняют; обрыв фразы на границе блока —
/// нет (это не полнота по ожидаемому тексту).
fn prefix_precision(expected: &str, said: &str) -> f32 {
    let exp = words_norm(expected);
    let got = words_norm(said);
    if got.is_empty() {
        return 0.0;
    }
    let hits = got
        .iter()
        .filter(|w| {
            exp.iter()
                .any(|e| e == *w || crate::text::word_similarity(e, w) >= 0.75)
        })
        .count();
    hits as f32 / got.len() as f32
}

/// Одна потоковая попытка: генерация на вызывающем потоке, декодер — на
/// своём (Metal), блоки проверяются и воспроизводятся по мере готовности.
#[allow(clippy::too_many_arguments)]
fn stream_attempt(
    engine: &mut ZonosEngine,
    decoder: &Arc<ZacDecoder>,
    text: &str,
    speaker: Option<&[f32]>,
    buckets: [usize; 3],
    sp: &Sampling,
    cfg_scale: f32,
    external_cancel: &AtomicBool,
    gain: &mut f32,
    emit: &mut dyn FnMut(Vec<f32>, bool),
    asr: Option<&'static crate::asr::model::FastConformer>,
) -> AttemptOutcome {
    let started = Instant::now();
    let (block_tx, block_rx) = channel::<StreamBlock>();
    let (audio_tx, audio_rx) = channel::<Result<(Vec<f32>, usize, usize, bool), String>>();
    let attempt_cancel = AtomicBool::new(false);

    // Декодер живёт на своём устройстве: пока бэкбон генерирует следующие
    // кадры, Metal собирает звук готовых.
    let decoder = Arc::clone(decoder);
    let dec_thread = std::thread::spawn(move || {
        let spf = decoder.samples_per_frame();
        for blk in block_rx {
            let res = decoder.decode(&blk.frames).map(|audio| {
                let from = ((blk.emit_start - blk.slice_start) * spf).min(audio.len());
                let to = ((blk.emit_end - blk.slice_start) * spf).min(audio.len());
                (audio[from..to].to_vec(), blk.emit_start, blk.emit_end, blk.last)
            });
            let res = res.map_err(|e| format!("{e:#}"));
            if audio_tx.send(res).is_err() {
                break;
            }
        }
    });

    let mut sink = Sink {
        text,
        asr,
        gain,
        emit,
        accepted: Vec::new(),
        first_done: false,
        first_sim: None,
        garbage: false,
        error: None,
        first_emit_secs: None,
    };

    {
        let mut on_block = |blk: StreamBlock| {
            if block_tx.send(blk).is_err() {
                return;
            }
            if !sink.first_done {
                // Первый блок ждём и проверяем до начала воспроизведения.
                match audio_rx.recv() {
                    Ok(res) => sink.take(res, started),
                    Err(_) => sink.error = Some("ZAC-декодер закрылся раньше времени".into()),
                }
            }
            while let Ok(res) = audio_rx.try_recv() {
                sink.take(res, started);
                if sink.garbage || sink.error.is_some() {
                    break;
                }
            }
            if sink.garbage || sink.error.is_some() || external_cancel.load(Ordering::SeqCst) {
                attempt_cancel.store(true, Ordering::SeqCst);
            }
        };
        let result = engine.synthesize_streaming(
            text,
            speaker,
            buckets,
            sp,
            cfg_scale,
            StreamingCfg {
                on_block: &mut on_block,
                cancel: &[external_cancel, &attempt_cancel],
                block_frames: super::engine::STREAM_BLOCK_FRAMES,
                first_block: super::engine::STREAM_FIRST_BLOCK,
                carry: super::engine::STREAM_CARRY,
                guard: super::engine::STREAM_GUARD,
            },
        );
        drop(on_block); // заём block_tx закрыт
        drop(block_tx); // теперь декодер дособерёт хвост и выйдет
        if let Err(e) = result {
            sink.error = sink.error.or_else(|| Some(format!("{e:#}")));
        }
    }
    let _ = dec_thread.join();
    while let Ok(res) = audio_rx.recv() {
        sink.take(res, started);
    }

    let final_sim = if sink.first_done && !sink.garbage && !sink.accepted.is_empty() {
        match sink.asr {
            Some(model) => {
                let pcm16 =
                    crate::tts_zonos::speaker::sinc_resample(&sink.accepted, SAMPLE_RATE, 16000);
                model
                    .transcribe(&pcm16)
                    .ok()
                    .map(|said| speech_similarity(text, said.text.trim()))
            }
            None => None,
        }
    } else {
        None
    };

    AttemptOutcome {
        first_played: sink.first_done,
        first_sim: sink.first_sim,
        final_sim,
        cancelled: external_cancel.load(Ordering::SeqCst),
        error: sink.error,
        first_emit_secs: sink.first_emit_secs,
    }
}

/// Ленивый FastConformer для самопроверки синтеза; None — модель не скачана.
/// Считаем на CPU: клип длиной 3–5 с на Metal тратит секунды на накладные
/// расходы мелких операций RNN-T, на CPU — десятые доли секунды.
fn voice_asr() -> Option<&'static crate::asr::model::FastConformer> {
    static ASR: std::sync::OnceLock<Option<crate::asr::model::FastConformer>> =
        std::sync::OnceLock::new();
    ASR.get_or_init(|| {
        crate::asr::model::FastConformer::load_on(
            &crate::paths::models_dir(),
            candle_core::Device::Cpu,
        )
        .ok()
    })
    .as_ref()
}

/// Сходство сказанного с текстом: слова, нормированные к нижнему регистру
/// без пунктуации (ё → е). Словесный Левенштейн, но замена слова на похожее
/// (≥ 0.75 по символам) считается совпадением: ASR путает «штатном» и
/// «статном», и пересинтез из-за одной буквы только добавляет секунды.
/// Порог 0.75 не пропускает заикания вроде «максимаксимальная» (0.73).
fn speech_similarity(expected: &str, said: &str) -> f32 {
    let a = words_norm(expected);
    let b = words_norm(said);
    if a.is_empty() || b.is_empty() {
        return 0.0;
    }
    const WORD_MATCH: f32 = 0.75;
    let (n, m) = (a.len(), b.len());
    let mut d: Vec<f32> = (0..=m).map(|j| j as f32).collect();
    for i in 1..=n {
        let mut prev = d[0];
        d[0] = i as f32;
        for j in 1..=m {
            let cur = d[j];
            let same = a[i - 1] == b[j - 1]
                || crate::text::word_similarity(&a[i - 1], &b[j - 1]) >= WORD_MATCH;
            let sub = prev + if same { 0.0 } else { 1.0 };
            d[j] = (d[j] + 1.0).min(d[j - 1] + 1.0).min(sub);
            prev = cur;
        }
    }
    1.0 - d[m] / n.max(m) as f32
}

#[cfg(test)]
mod tests {
    use super::speech_similarity;

    #[test]
    fn identical_text_is_one() {
        let sim = speech_similarity("Привет, сэр. Все системы в норме.", "привет сэр все системы в норме");
        assert!((sim - 1.0).abs() < 1e-6, "{sim}");
    }

    #[test]
    fn minor_asr_error_passes() {
        let sim = speech_similarity(
            "Все системы работают в штатном режиме.",
            "Все системы работают в статном режиме.",
        );
        assert!(sim >= 0.88, "ASR-огрех не должен запускать пересинтез: {sim}");
    }

    #[test]
    fn real_garbling_fails() {
        let sim = speech_similarity(
            "Все системы работают в штатном режиме.",
            "Все системы работают в тост от отнажены.",
        );
        assert!(sim < 0.88, "искажение должно уходить в пересинтез: {sim}");
    }

    #[test]
    fn repeated_syllable_fails() {
        let sim = speech_similarity(
            "Курс установлен, скорость максимальная.",
            "Курс установлен, скорость максимаксимальная.",
        );
        assert!(sim < 0.88, "заикание должно уходить в пересинтез: {sim}");
    }

    #[test]
    fn truncation_fails() {
        let sim = speech_similarity(
            "Обнаружено входящее сообщение, сэр.",
            "Обнаружено входящее сообщение, с",
        );
        assert!(sim < 0.88, "обрыв фразы должен уходить в пересинтез: {sim}");
    }
}
